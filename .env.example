# ============================================
# Backend - Configuración de Runtime (Node.js)
# ============================================
# Este .env es para ejecutar el backend de forma AISLADA (sin Docker).
# En Docker, estas variables las inyecta docker-compose.yml.
# Copia este archivo: cp .env.example .env
# ============================================

# --- Servidor Express ---
PORT=3000
FRONTEND_PORT=5173

# --- Conexión a PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pizzaclick_db
POSTGRES_USER=admin_pizza
POSTGRES_PASSWORD=CHANGE_ME
